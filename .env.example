# Required. Planning, extraction, and the written reply. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. Web search and page extracts. https://tavily.com
TAVILY_API_KEY=

# Required. Local MongoDB or an Atlas connection string. This is the memory.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mbfbang.mongodb.net/

# Optional. Fast model classifies the turn and extracts claims.
LLM_FAST_MODEL=gemini-3.5-flash

# Optional. Writes the reply once the evidence is in.
LLM_ANSWER_MODEL=gemini-3.5-flash

# Dates in questions are resolved in this zone. Stored instants stay UTC.
USER_TIMEZONE=Asia/Kolkata

PORT=3001
